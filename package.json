{
  "name": "purescript-oak",
  "version": "1.0.0",
  "description": "Oak is an implementation of the Elm architecture in Purescript.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "spago build",
    "build:test-app": "spago build && esbuild test/entry.js --bundle --platform=browser --outfile=test/app.js",
    "test": "spago test && npm run build:test-app && node scripts/open-browser.mjs test/index.html",
    "build:router-app": "spago build && esbuild test/router-entry.js --bundle --platform=browser --outfile=test/router.js",
    "router-app": "npm run build:router-app && node scripts/open-browser.mjs test/router.html",
    "build:board-app": "spago build && esbuild test/board-entry.js --bundle --platform=browser --outfile=test/board.js",
    "board-app": "npm run build:board-app && node scripts/open-browser.mjs test/board.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehrenmurdick/purescript-oak.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ehrenmurdick/purescript-oak/issues"
  },
  "homepage": "https://github.com/ehrenmurdick/purescript-oak#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^8.41.0",
    "open": "^11.0.2",
    "purescript": "^0.15.16",
    "spago": "^1.0.4",
    "virtual-dom": "^2.1.1"
  }
}
